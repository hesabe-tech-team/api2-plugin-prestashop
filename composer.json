{
    "name": "ruptyx/hesabe-prestashop",
    "description": "Hesabe payments for PrestaShop 8.1 and later: KNET, cards and refunds.",
    "type": "prestashop-module",
    "license": "MIT",
    "authors": [
        {
            "name": "the hesabe SDK authors"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ruptyx/hesabe-php"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ruptyx/hesabe": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "prestashop/php-dev-tools": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Hesabe\\PrestaShop\\": "src/"
        }
    },
    "config": {
        "prepend-autoloader": false,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "extra": {
        "installer-name": "hesabe"
    }
}
